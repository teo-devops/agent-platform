# La imagen donde se ejecuta lo que lanza un agente con sandbox (backends local y
# openshell; sbx usa su propia plantilla). Contexto: deploy/images.
#
# Sin root y con /workspace suyo: OpenShell rechaza imágenes que corren como
# root, y python:3.12-slim no trae ni lo uno ni lo otro.
FROM python:3.12-slim

RUN groupadd --gid 1000 sandbox \
 && useradd --uid 1000 --gid 1000 --create-home --shell /bin/sh sandbox \
 && mkdir -p /workspace && chown 1000:1000 /workspace

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /workspace
USER 1000:1000
CMD ["sleep", "infinity"]
